{
  "name": "bluemates-web",
  "version": "2.0.3",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:import-sites": "node scripts/import-osm-dive-sites.mjs && node scripts/import-opendivemap-sites.mjs",
    "db:seed-demo": "node prisma/seed-demo.mjs",
    "version:func": "npm version patch --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "3.0.2",
    "jose": "6.0.12",
    "lucide-react": "0.468.0",
    "maplibre-gl": "^5.24.0",
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.17.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "9.34.0",
    "eslint-config-next": "^16.3.0",
    "prisma": "^6.19.3",
    "typescript": "5.9.2",
    "vitest": "^3.2.7"
  }
}
